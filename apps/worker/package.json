{
  "name": "@equbflow/worker",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "dry-run": "node dist/index.js --dry-run",
    "test": "vitest run"
  },
  "dependencies": {
    "@equbflow/domain": "workspace:*",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.11",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
